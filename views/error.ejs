<%- include('partials/header', { title: 'Error' }) %>

<!-- Error page: message and status come from the error handler in app.js -->
<section class="container py-5 text-center">
  <h1 class="display-5"><i class="fa-solid fa-triangle-exclamation text-warning me-2"></i><%= message %></h1>
  <h2 class="h5 text-muted"><%= error.status %></h2>
  <pre class="text-start small"><%= error.stack %></pre>
  <a href="/" class="btn btn-brand mt-3"><i class="fa-solid fa-house me-2"></i>Back to Home</a>
</section>

<%- include('partials/footer') %>
