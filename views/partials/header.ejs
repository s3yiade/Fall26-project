<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> | <%= siteName %></title>
  <link rel="icon" href="/images/logo.svg" type="image/svg+xml">

  <!-- Bootstrap 5 and Font Awesome 6 from CDNs -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
  <!-- Our own styles (public/stylesheets/style.css) -->
  <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body class="d-flex flex-column min-vh-100">

<!-- Shared navbar: logo + site name on the left, links on the right -->
<nav class="navbar navbar-expand-md navbar-dark bg-brand">
  <div class="container">
    <a class="navbar-brand d-flex align-items-center fw-bold" href="/">
      <img src="/images/logo.svg" alt="" width="36" height="36" class="me-2">
      <%= siteName %>
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
            aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="mainNav">
      <ul class="navbar-nav ms-auto">
        <li class="nav-item"><a class="nav-link" href="/"><i class="fa-solid fa-house me-1"></i>Home</a></li>
        <li class="nav-item"><a class="nav-link" href="/#sessions"><i class="fa-solid fa-list me-1"></i>Sessions</a></li>
        <li class="nav-item"><a class="nav-link" href="/create"><i class="fa-solid fa-plus me-1"></i>Host a Session</a></li>
      </ul>
    </div>
  </div>
</nav>

<main class="flex-grow-1">
